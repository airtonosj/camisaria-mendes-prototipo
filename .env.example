# Ambiente da API
# Em `production` a API trava a carga de demonstração e avisa no boot sobre senha de
# fábrica, chave curta e usuário de teste.
#
# Use APP_ENV, nunca NODE_ENV, neste arquivo: o Vite também lê o .env, e um
# NODE_ENV=development aqui faria `npm run build` gerar o pacote de desenvolvimento,
# levando campanhas, pedidos e credenciais de demonstração para o site publicado.
APP_ENV=development

# API
VITE_API_URL=http://127.0.0.1:3333/api
# Na Hostinger Business use API_HOST=0.0.0.0 e API_PORT=3000. Se a
# plataforma fornecer PORT automaticamente, ele tem prioridade sobre API_PORT.
API_HOST=127.0.0.1
API_PORT=3333
# Ative somente quando a API estiver atrás de um proxy reverso confiável. Na
# Hostinger Web App use true para identificar o cliente real nos limites de abuso.
TRUST_PROXY=false
# Origens do navegador autorizadas, separadas por virgula. Precisa bater com a porta do Vite.
CORS_ORIGIN=http://127.0.0.1:4173,http://localhost:4173
# Chave de manutenção usada por scripts, nunca pelo navegador. Gere com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Em produção fica desabilitada por padrão. Só habilite temporariamente para manutenção.
ADMIN_API_TOKEN_ENABLED=false
ADMIN_API_TOKEN=troque-por-uma-chave-longa-e-aleatoria
# Configure ADMIN_INITIAL_* apenas no primeiro deploy. Depois da troca obrigatória,
# remova ADMIN_INITIAL_PASSWORD e faça um novo deploy.
ADMIN_INITIAL_NAME=Gustavo Mendes
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
# Endereço público do site. Entra no link de redefinição de senha enviado por e-mail.
PUBLIC_APP_URL=http://127.0.0.1:4173

# MySQL 8
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=camisaria_mendes
DB_USER=camisaria
DB_PASSWORD=troque-esta-senha
DB_CONNECTION_LIMIT=10

# Em produção use um caminho persistente fora da pasta substituída durante o deploy,
# por exemplo /var/lib/camisaria-mendes/uploads.
UPLOADS_DIR=

# Backup operacional. Em produção, use uma pasta persistente fora do projeto.
# O usuário de backup precisa apenas de SELECT, SHOW VIEW, TRIGGER e EVENT.
BACKUP_DIR=
BACKUP_RETENTION_DAYS=14
BACKUP_DB_USER=
BACKUP_DB_PASSWORD=
# Opcional no Linux. No Windows local, informe o caminho completo do mysqldump.exe.
MYSQLDUMP_BIN=mysqldump

# Health check usado depois do restart/deploy.
HEALTHCHECK_URL=http://127.0.0.1:3333/api/health
HEALTHCHECK_ATTEMPTS=12
HEALTHCHECK_INTERVAL_MS=2500

# Recuperação de senha por e-mail (opcional em desenvolvimento, obrigatória em produção)
# Sem SMTP_HOST, a tela de "esqueci minha senha" avisa que o envio não está
# configurado e o link precisa ser gerado por `npm run user:reset`.
# Na Hostinger: smtp.hostinger.com, porta 465 (SSL) ou 587 (STARTTLS).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Camisaria Mendes
# Opcional para `npm run ops:email:test` quando o destinatário não for passado no comando.
SMTP_TEST_RECIPIENT=
# Intervalo da fila de confirmações de pagamento (mínimo efetivo: 5 segundos).
EMAIL_DELIVERY_INTERVAL_MS=30000

# Pagamento
# A InfinitePay usa a InfiniteTag sem o caractere `$` como `handle` do checkout.
# Mantenha a trava em false até concluir uma compra real de baixo valor e conferir
# checkout, webhook, payment_check, e-mail e relatório de produção.
PAYMENT_PROVIDER=infinitepay
INFINITEPAY_HANDLE=
INFINITEPAY_CHECKOUT_ENABLED=false
# Somente testes locais devem substituir a URL oficial. Produção recusa override.
# INFINITEPAY_API_BASE_URL=http://127.0.0.1:3335
INFINITEPAY_REQUEST_TIMEOUT_MS=8000
PAYMENT_RECONCILIATION_INTERVAL_MS=5000

# Teste de restauração. O nome precisa terminar em `_restore_test` e ainda não existir.
# RESTORE_DB_NAME=camisaria_release_restore_test
# RESTORE_DB_USER=camisaria_migrator
# RESTORE_DB_PASSWORD=
# RESTORE_UPLOADS_DIR=/tmp/camisaria-restore/uploads
# MYSQL_BIN=mysql
