{
  "name": "camisaria-mendes-prototipo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api:dev": "node --watch api/server.mjs",
    "api:start": "node api/server.mjs",
    "db:create": "node api/create-database.mjs",
    "db:migrate": "node api/migrate.mjs",
    "db:seed": "node api/seed.mjs",
