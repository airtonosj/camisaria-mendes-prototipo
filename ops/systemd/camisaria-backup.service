[Unit]
Description=Backup da Camisaria Mendes
After=mysql.service

[Service]
Type=oneshot
User=camisaria
Group=camisaria
WorkingDirectory=/var/www/camisaria/current
EnvironmentFile=/etc/camisaria-mendes/api.env
ExecStart=/usr/bin/node ops/backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/camisaria-mendes
